# Copy these values into your local environment; never commit real secrets.
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/pixelchat
DB_USER=pixelchat
DB_PASSWORD=replace_with_a_strong_password
PIXEL_CHAT_DEV_MODE=false

# SMTP is required to deliver real verification emails.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@your-domain.example
